# Backend Environment — Copy to .env.local
# cp .env.example .env.local

# Server
API_BACKEND_HOST=127.0.0.1
API_BACKEND_PORT=3004
API_PAYLOAD_MAX_SIZE=7mb

# PageSpeed Insights (optional — fallback works without)
# PSI_API_KEY=your_key

# Optional provider key used by the frontend's server-side Gemini route when
# Next.js and this backend share the same environment configuration.
# GEMINI_API_KEY=your_server_only_api_key

# SMTP (Brevo) — for /api/contact, /api/leads
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_email
SMTP_PASS=your_password
SMTP_FROM=hello@imi.ge
SMTP_TO=hello@imi.ge

# Vertex AI Proxy (optional — /api-proxy returns 503 if missing)
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1
